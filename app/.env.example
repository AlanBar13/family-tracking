# ---------------------------------------------------------------------------
# Copia este archivo a `.env` (o `.env.local`) y llena los valores.
# Solo las variables con prefijo VITE_ llegan al navegador: nunca pongas
# secretos ahí.
# ---------------------------------------------------------------------------

# URL del proyecto de Supabase.
# Sale de: Supabase > Project Settings > API > Project URL.
# PÚBLICA (llega al navegador).
VITE_SUPABASE_URL=

# Clave anon / "publishable key" de Supabase.
# Sale de: Supabase > Project Settings > API (según el panel, se llama anon o publishable).
# PÚBLICA (llega al navegador); la protección real la da RLS.
VITE_SUPABASE_ANON_KEY=

# Clave service_role / "secret key" de Supabase. Se salta RLS.
# Sale de: Supabase > Project Settings > API.
# SECRETA. SOLO para scripts locales (migración) y para `pnpm e2e`, que crea usuarios de
# prueba en la base de DESARROLLO. Nunca en Vercel ni en el código del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# API key de Gemini para el lector de tickets.
# Sale de: aistudio.google.com/apikey.
# SECRETA. Solo la usa el servidor; nunca lleva prefijo VITE_.
GEMINI_API_KEY=

# Modelo de Gemini a usar. Opcional: si se deja vacío se usa gemini-3.5-flash-lite.
# Sale de: la lista de modelos de Google AI Studio.
# No es secreta (solo servidor).
GEMINI_MODELO=

# Credenciales OAuth de Google para el login (Google Cloud Console > Credenciales).
# Las lee `supabase start` (config.toml) en local; en la nube se capturan en
# Supabase > Authentication > Providers > Google.
# SECRETAS. Nunca con prefijo VITE_.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Zona horaria del hogar; "hoy" y "mes actual" se calculan con ella.
# Valor normal: America/Mexico_City (nombre IANA).
# No es secreta (solo servidor).
HOGAR_ZONA_HORARIA=America/Mexico_City
